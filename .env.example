# Copy this file to .env and fill in your real keys. Never commit .env itself.

# Google AI Studio (Gemini) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Groq (qwen/qwen3.6-27b vision) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# OpenRouter (OpenRouter) - https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_key_here

# Zoho Books - https://api-console.zoho.com/ (added in a later step)
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ORGANIZATION_ID=your_zoho_org_id
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_API_BASE=https://www.zohoapis.in/books/v3
